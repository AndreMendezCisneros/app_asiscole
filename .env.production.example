# Plantilla para producción — VPS dedicado del canal (Hetzner Opción B: ~8 CPU / 32 GB).
# Copiar a `.env` en el servidor — NO usar `.env.example` de desarrollo.

# Django — OBLIGATORIO: secret aleatorio ≥32 chars; DEBUG siempre False.
DJANGO_SECRET_KEY=REEMPLAZAR_CON_SECRET_ALEATORIO_LARGO
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=jeanpiaget.asiscole.com,localhost,127.0.0.1
# False detrás de Caddy/Cloudflare (recomendado). True solo si Django termina TLS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_LOG_LEVEL=INFO

# BD CENTRAL (Supabase del canal). Desactivar Data API / PostgREST del proyecto
# o aplicar db/migrations/007_central_rls_lockdown.sql.
# Preferir pooler Session/Transaction (IPv4) en VPS sin IPv6.
CENTRAL_DB_NAME=postgres
CENTRAL_DB_USER=postgres
CENTRAL_DB_PASSWORD=
CENTRAL_DB_HOST=db.XXXXXXXX.supabase.co
CENTRAL_DB_PORT=5432
CENTRAL_DB_SSLMODE=require
# Conexiones persistentes por proceso Gunicorn/Celery (pooler recomendado).
CENTRAL_DB_CONN_MAX_AGE=60
CENTRAL_DB_TIMEOUT_SECONDS=5

# Redis con contraseña (alineado a docker-compose.prod.yml).
REDIS_PASSWORD=REEMPLAZAR_REDIS_PASSWORD
REDIS_URL=redis://:REEMPLAZAR_REDIS_PASSWORD@redis:6379/0
USE_LOCMEM_CACHE=False
POLL_OUTBOX_INLINE=False
# Tope de RAM de Redis en caja 32 GB (compose también aplica mem_limit).
REDIS_MAXMEMORY=2gb
REDIS_MEM_LIMIT=2560m

# ---------------------------------------------------------------------------
# Capacidad — perfil Hetzner Opción B (~8 núcleos / 32 GB RAM)
# ≈ 32 requests HTTP en paralelo + Celery 6 para push/outbox.
# En máquina más pequeña: bajar a 4/4/2. En 12+ cores: subir workers a 10–12.
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=8
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
GUNICORN_MAX_REQUESTS=1200
CELERY_CONCURRENCY=6
CELERY_MAX_TASKS_PER_CHILD=200
BACKEND_MEM_LIMIT=12g
WORKER_MEM_LIMIT=6g
BEAT_MEM_LIMIT=512m

SESSION_TOKEN_DAYS=10
SESSION_RENEW_WINDOW_DAYS=3
DATA_TOKEN_MINUTES=60
TRANSFER_REQUEST_TTL_MINUTES=5

LOGIN_MAX_ATTEMPTS=3
LOGIN_ATTEMPT_WINDOW_MINUTES=60
LOGIN_LOCKOUT_MINUTES=5
LOGIN_LOCKOUT_ESCALATED_MINUTES=10
LOGIN_HARD_MAX_ATTEMPTS=8
LOGIN_HARD_LOCKOUT_MINUTES=1440
TRANSFER_MAX_PER_HOUR=3

MESSAGE_RETENTION_MONTHS=24

DIRECTORY_CACHE_TTL_SECONDS=86400
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
# Timeout corto: colegio lento no atasca el pool de workers bajo pico.
SCHOOL_DB_TIMEOUT_SECONDS=8
SCHOOL_DB_CONN_MAX_AGE=60

SCHOOL_DATABASES=[]

FCM_CREDENTIALS_PATH=/secrets/fcm-adminsdk.json
FCM_ANDROID_CHANNEL_ID=asiscole_avisos_v3

TERMINOS_VERSION=2026-07-28

# Clave de ingesta (rotar por entorno; idealmente una por tenant a futuro).
INGEST_API_KEY=REEMPLAZAR_INGEST_API_KEY
