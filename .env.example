# Django
DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# ---------------------------------------------------------------------------
# BD CENTRAL del canal — proyecto Supabase PROPIO del canal (no el del colegio)
# ---------------------------------------------------------------------------
# Crear un proyecto nuevo en https://supabase.com (ej. "asiscole-canal").
# En Project Settings → Database → Connection string → URI (o Session mode).
#
# Ejemplo (rellenar con tus valores reales):
#   Host:     db.XXXXXXXX.supabase.co
#   Database: postgres
#   User:     postgres
#   Password: (Database password del proyecto)
#   Port:     5432
#   SSL:      require
#
# NO uses aquí la BD de un colegio (Jean Piaget, etc.). Esa va en SCHOOL_DATABASES.
CENTRAL_DB_NAME=postgres
CENTRAL_DB_USER=postgres
CENTRAL_DB_PASSWORD=
CENTRAL_DB_HOST=db.XXXXXXXX.supabase.co
CENTRAL_DB_PORT=5432
CENTRAL_DB_SSLMODE=require

# Redis (cache + Celery). Con Docker: `docker compose up -d redis`
# Sin Docker, para solo `runserver`: USE_LOCMEM_CACHE=True
# Con USE_LOCMEM_CACHE=True el runserver vacía asis_outbox en un hilo
# (POLL_OUTBOX_INLINE). Con Redis: celery -A config worker -B
REDIS_URL=redis://localhost:6379/0
USE_LOCMEM_CACHE=False
# POLL_OUTBOX_INLINE=  # por defecto = USE_LOCMEM_CACHE
# POLL_OUTBOX_INLINE_SECONDS=15

# Tokens (RNF-01 / SRS 14.1)
SESSION_TOKEN_DAYS=10
SESSION_RENEW_WINDOW_DAYS=3
DATA_TOKEN_MINUTES=60
TRANSFER_REQUEST_TTL_MINUTES=5

# Rate limiting del login (SRS 14.3) — escalonado: 3→5min / +fallos→10min / ~8→24h
LOGIN_MAX_ATTEMPTS=3
LOGIN_ATTEMPT_WINDOW_MINUTES=60
LOGIN_LOCKOUT_MINUTES=5
LOGIN_LOCKOUT_ESCALATED_MINUTES=10
LOGIN_HARD_MAX_ATTEMPTS=8
LOGIN_HARD_LOCKOUT_MINUTES=1440
TRANSFER_MAX_PER_HOUR=3

# Retencion de mensajes en la BD central (RNF-11)
MESSAGE_RETENTION_MONTHS=24

# Resiliencia multi-BD (SRS 7.8)
SCHOOL_DB_TIMEOUT_SECONDS=2
DIRECTORY_CACHE_TTL_SECONDS=86400
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Colegios (tenants). Cada uno es OTRO proyecto/BD Supabase de Asiscole.
# En VPS sin IPv6 NO uses db.<ref>.supabase.co (solo AAAA): usa el pooler
# Session/Transaction, p. ej. aws-1-us-west-2.pooler.supabase.com:6543
# y user postgres.<project-ref>. sslmode=require.
# Si la password tiene `$`, en docker-compose escríbela como `$$`.
# [{"tenant_id":"jean_piaget","nombre":"Jean Piaget",
#   "host":"aws-1-us-west-2.pooler.supabase.com","port":6543,"name":"postgres",
#   "user":"postgres.xxxxx","password":"...","sslmode":"require"}]
SCHOOL_DATABASES=[]
SCHOOL_DB_TIMEOUT_SECONDS=15

# Push — JSON de cuenta de servicio Firebase Admin (mismo proyecto que la app).
# En docker-compose.prod.yml el volumen es ./secrets:/secrets:ro
# Coloca el archivo en secrets/fcm-adminsdk.json y usa:
FCM_CREDENTIALS_PATH=/secrets/fcm-adminsdk.json
# Local (fuera de Docker), ruta absoluta o relativa al cwd de manage.py, p. ej.:
# FCM_CREDENTIALS_PATH=../secrets/fcm-adminsdk.json
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# Ingesta HTTP (Asiscole → POST /v0.1/ingesta/eventos). Cabecera X-Asiscole-Ingest-Key.
INGEST_API_KEY=
