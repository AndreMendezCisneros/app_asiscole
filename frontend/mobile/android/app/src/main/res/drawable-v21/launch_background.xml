<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo: el mismo fondo y logo que la pantalla de arranque de Flutter,
     para que el paso de uno a otro no se note. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fondo" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_asiscole_logo" />
    </item>
</layer-list>
